{
  "name": "docs.rustfs.com",
  "version": "1.0.0",
  "description": "RustFS documentation site, powered by FumaPress (Waku + Fumadocs).",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "fumapress dev",
    "build": "fumapress build && node scripts/add-language-redirects.mjs && node scripts/sync-algolia.mjs",
    "start": "sirv dist/public",
    "types:check": "fumadocs-mdx && tsc --noEmit",
    "docs:check": "node scripts/docs-check.mjs",
    "test:worker": "node --test scripts/worker-redirects.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fumapress/language": "^1.1.3",
    "@shikijs/transformers": "^4.3.1",
    "algoliasearch": "^5.56.0",
    "fumadocs-core": "^16.16.2",
    "fumadocs-mdx": "^15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.16.2",
    "fumapress": "1.6.0",
    "katex": "^0.17.0",
    "mermaid": "^11.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sirv-cli": "^3.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
